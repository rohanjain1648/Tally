# ── Groq (required for Capture, Ask Tally and the daily briefing) ──
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
# Chat agent. Needs tool calling; llama-3.3-70b-versatile also supports parallel tool calls.
# GROQ_MODEL=llama-3.3-70b-versatile
# Reads photos and returns schema-strict JSON for Capture. Needs vision.
# GROQ_VISION_MODEL=qwen/qwen3.8-27b

# ── PayPal sandbox (optional) ──
# Leave these empty to run on Tally's built-in PayPal simulator (mock mode).
# Create a sandbox app at https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook id from the sandbox app's webhook settings; enables signature verification.
PAYPAL_WEBHOOK_ID=
# Force a mode: "sandbox" or "mock". Default: sandbox if keys are present, otherwise mock.
# PAYPAL_MODE=

# ── App ──
BUSINESS_NAME=Rivera Design Studio
CURRENCY=USD
PORT=8787
# Public URL PayPal redirects payers back to (use your Render URL when deployed).
PUBLIC_URL=http://localhost:8787
# DATA_FILE=data/tally.json
